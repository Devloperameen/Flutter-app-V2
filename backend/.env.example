# ============================================
# FitFlow Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ─── Server Configuration ───────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─── Database Configuration ─────────────────
# Local MongoDB: mongodb://localhost:27017/fitflow
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/fitflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fitflow

# ─── JWT Secrets (Change these in production!) ─────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Logging ─────────────────────────────
LOG_LEVEL=info

# ─── CORS Configuration ──────────────────
# Your Flutter app URL(s)
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# ─── Email Configuration (optional) ──────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Firebase (if needed for other features) ────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
